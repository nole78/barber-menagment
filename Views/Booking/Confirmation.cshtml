@model BarberMenagment.Models.Booking.BookingConfirmationViewModel
@{
    ViewData["Title"] = "Booking confirmed";
}

<div class="text-center">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">Your appointment has been saved.</p>
    @if (TempData["BookingEmailWarning"] is string bookingEmailWarning)
    {
        <div class="alert alert-warning">@bookingEmailWarning</div>
    }
    else
    {
        <p class="text-muted">A confirmation email was sent to your account email address.</p>
    }
    <dl class="row justify-content-center">
        <dt class="col-sm-3">Barber</dt>
        <dd class="col-sm-5">@Model.BarberName</dd>
        <dt class="col-sm-3">Service</dt>
        <dd class="col-sm-5">@Model.ServiceName</dd>
        <dt class="col-sm-3">Date and time</dt>
        <dd class="col-sm-5">@Model.AppointmentDateTime.ToString("f")</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-5">@Model.Price.ToString("C")</dd>
    </dl>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>
