@using System.Globalization
@model BarberMenagment.Models.Booking.BookingConfirmationViewModel
@{
    ViewData["Title"] = "Booking confirmed";
    var serbianCulture = new CultureInfo("sr-RS");
}

<div class="text-center">
    <h1>@ViewData["Title"]</h1>
    <p class="lead">Your appointment has been saved.</p>
    @if (TempData["BookingEmailWarning"] is string bookingEmailWarning)
    {
        <div class="alert alert-warning">@bookingEmailWarning</div>
    }
    else
    {
        <p class="text-muted">A confirmation email was sent to your account email address.</p>
    }
    <dl class="row justify-content-center">
        <dt class="col-sm-5" style="text-align: right; color: #f28a2e">Barber</dt>
        <dd class="col-sm-7" style="text-align: left">@Model.BarberName</dd>
        <dt class="col-sm-5" style="text-align: right; color: #f28a2e">Service</dt>
        <dd class="col-sm-7" style="text-align: left">@Model.ServiceName</dd>
        <dt class="col-sm-5" style="text-align: right; color: #f28a2e">Date and time</dt>
        <dd class="col-sm-7" style="text-align: left">@Model.AppointmentDateTime.ToString("f")</dd>
        <dt class="col-sm-5" style="text-align: right; color: #f28a2e">Price</dt>
        <dd class="col-sm-7" style="text-align: left">@Model.Price.ToString("C", serbianCulture)</dd>
    </dl>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to home</a>
</div>
