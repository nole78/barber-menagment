<!--
THESIS: A calm, practical salon console that makes booking and daily operations feel deliberate, not generic.
OWN-WORLD: Matte graphite surfaces, warm orange actions, and restrained red status signals with crisp utility typography.
STORY: Visitors immediately understand where to book, manage appointments, or run the barber panel.
FIRST VIEWPORT: A compact navigation bar leads into a focused content column with one clear primary action.
FORM: Operate-first layout; replaces the default Bootstrap white scaffold with a structured, high-contrast salon workspace.
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Radisav Fashion</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/BarberMenagment.styles.css" asp-append-version="true"/>
</head>
<body>
<header class="site-header" style="background-color: #f28a2e">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <span style="font-size: 20px">Radisav <span class="brand-muted" style="color:black">Fashion</span></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse justify-content-between">
                <ul class="navbar-nav gap-sm-1">
                    <li class="nav-item" style="color:black">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><span style="color: black">Početna</span></a>
                    </li>
                    @if (User.IsInRole("Barber"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Barber" asp-action="Index"><span style="color: black">Frizerski panel</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Barber" asp-action="Services"><span style="color: black">Usluge</span></a>
                        </li>
                    }
                    @if (User.IsInRole("Client"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Appointments"><span style="color: black">Moji termini</span></a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <div class="nav-user user-label" style="vertical-align: center; font-weight: bold">@User.Identity.Name</div>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link"><span style="color: darkred">Odjavi se</span></button>
                            </form>
                        </li>
                        }
                        else
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login"><span style="color: black">Prijavi se</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-cta" asp-controller="Account" asp-action="Register"><span style="color: black">Registracija</span></a>
                        </li>
                        }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container site-content">
    <main role="main">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>