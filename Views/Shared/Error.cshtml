@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}

<section class="error-page">
    <span class="error-page__code" aria-hidden="true">500</span>
    <p class="eyebrow">Nešto nije u redu</p>
    <h1>Ova stranica trenutno nije dostupna.</h1>
    <p>Pokušajte ponovo ili se vratite na pregled salona.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id">ID zahteva: <code>@Model.RequestId</code></p>
    }
    <a class="button button--primary" asp-area="" asp-controller="Home" asp-action="Index">Nazad na pregled</a>
</section>
