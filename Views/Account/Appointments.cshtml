@model IReadOnlyList<BarberMenagment.Models.Booking.ClientAppointmentViewModel>
@{
    ViewData["Title"] = "Moji termini";
}
<h1>Moji aktivni termini</h1>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["AppointmentError"] is string appointmentError)
{
    <div class="alert alert-danger">@appointmentError</div>
}
@if (Model.Count == 0)
{
    <div class="alert alert-info">Nemate budućih aktivnih termina.</div>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Datum i vreme</th><th>Frizer</th><th>Usluga</th><th>Cena</th><th></th></tr></thead>
            <tbody>
            @foreach (var appointment in Model)
            {
                <tr>
                    <td>@appointment.AppointmentDateTime.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</td>
                    <td>@appointment.BarberName</td>
                    <td>@appointment.ServiceName</td>
                    <td>@appointment.Price.ToString("C")</td>
                    <td>
                        <form asp-action="CancelAppointment" method="post">
                            <input type="hidden" name="id" value="@appointment.Id"/>
                            <button type="submit" class="btn btn-outline-danger">Otkaži</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
