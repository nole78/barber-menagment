@model BarberMenagment.Models.Barber.BarberDashboardViewModel
@{
    ViewData["Title"] = "Frizerski panel";
}

<p class="eyebrow">Radisav Fashion / Kontrolni centar</p>
<h1>Dobro došli, <span style="color: #f28a2e; text-decoration: underline">@Model.BarberName</span></h1>
<p class="lead">Upravljajte terminima i radnim smenama.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card"><div class="card-body"><h2 class="h6">Budući termini</h2><strong class="fs-3">@Model.UpcomingAppointmentCount</strong></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><h2 class="h6">Današnji termini</h2><strong class="fs-3">@Model.TodayAppointmentCount</strong></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><h2 class="h6">Definisane buduće smene</h2><strong class="fs-3">@Model.DefinedShiftCount</strong></div></div></div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-action="Appointments" class="btn btn-primary">Pregled termina</a>
    <a asp-action="Shifts" class="btn btn-outline-primary">Definiši smenu</a>
    <a asp-action="InternalBooking" class="btn btn-outline-secondary">Interno zakazivanje</a>
</div>
