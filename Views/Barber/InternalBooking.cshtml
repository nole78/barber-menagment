@model BarberMenagment.Models.Barber.InternalBookingViewModel
@{
    ViewData["Title"] = "Interno zakazivanje";
}

<h1>Interno zakazivanje</h1>
<p class="text-muted">Frizer: @Model.BarberName</p>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="InternalBooking" method="get" class="row g-3 mb-4">
    <div class="col-md-5">
        <label asp-for="ServiceId" class="form-label"></label>
        <select asp-for="ServiceId" class="form-select" asp-items="@(new SelectList(Model.Services, nameof(BarberMenagment.Models.Barber.InternalBookingServiceOption.Id), nameof(BarberMenagment.Models.Barber.InternalBookingServiceOption.Name)))">
            <option value="">Izaberite uslugu</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control"/>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Prikaži slobodne termine</button>
    </div>
</form>

<form asp-action="InternalBooking" method="post">
    <input asp-for="ServiceId" type="hidden"/>
    <input asp-for="Date" type="hidden"/>
    <div class="mb-3">
        <label asp-for="AppointmentDateTime" class="form-label"></label>
        <select asp-for="AppointmentDateTime" class="form-select">
            <option value="">Izaberite termin</option>
            @foreach (var slot in Model.AvailableSlots)
            {
                <option value="@slot.Start.ToString("O")">@slot.DisplayTime</option>
            }
        </select>
        <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ClientEmail" class="form-label"></label>
        <input asp-for="ClientEmail" class="form-control"/>
        <div class="form-text">Ostavite prazno za neregistrovanog klijenta.</div>
        <span asp-validation-for="ClientEmail" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Sačuvaj interni termin</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
