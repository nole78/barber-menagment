@{
    ViewData["Title"] = "Privatnost";
}

<section class="simple-page">
    <p class="eyebrow">Informacije</p>
    <h1>Politika privatnosti</h1>
    <p class="simple-page__lead">Barber Management čuva samo podatke potrebne za organizaciju rada salona i upravljanje rezervacijama.</p>
    <div class="prose">
        <h2>Koje podatke koristimo</h2>
        <p>Podaci o klijentima, terminima i uslugama koriste se isključivo za svakodnevno poslovanje salona. Ne prodajemo lične podatke niti ih koristimo za profilisanje.</p>
        <h2>Vaša kontrola</h2>
        <p>Za pitanja o podacima ili zahtev za izmenu i brisanje, obratite se administratoru vašeg salona.</p>
    </div>
    <a class="button button--secondary" asp-area="" asp-controller="Home" asp-action="Index">← Nazad na pregled</a>
</section>